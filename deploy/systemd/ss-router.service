[Unit]
Description=SafeSwitch Router Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/safeswitch
ExecStart=/usr/bin/safeswitch-node
Restart=always
RestartSec=3

Environment=SS_ROUTER_ENV=prod
Environment=SS_ROUTER_DATA_DIR=/var/lib/safeswitch
Environment=SS_ROUTER_DB_PATH=/var/lib/safeswitch/router.db
Environment=SS_ROUTER_HTTP_ADDR=127.0.0.1:8099
Environment=SS_ROUTER_DNS_ADDR=0.0.0.0:5353
Environment=SS_ROUTER_SYNC_BASE_URL=https://api.getsafeswitch.app
Environment=SS_ROUTER_HEARTBEAT_SEC=30
Environment=SS_ROUTER_COMMAND_POLL_SEC=5
Environment=SS_ROUTER_SHUTDOWN_TIMEOUT_SEC=10

[Install]
WantedBy=multi-user.target
